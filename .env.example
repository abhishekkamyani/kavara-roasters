# MongoDB connection string, including the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/kavara-roasters

# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# the sitemap and social previews. Not needed for local development.
NEXT_PUBLIC_SITE_URL=

# NextAuth session secret. Generate one with: npx auth secret
AUTH_SECRET=
# Needed when running `next start` outside Vercel (e.g. on localhost).
AUTH_TRUST_HOST=true

# UploadThing v7 token (Dashboard -> API Keys). It bundles the secret key and
# app id that older SDKs took as UPLOADTHING_SECRET / UPLOADTHING_APP_ID.
UPLOADTHING_TOKEN=
